{
  "name": "create-llm-agent",
  "version": "1.0.2",
  "description": "Quickly scaffold a TypeScript-based LLM agent application with local or remote AI models",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "create-llm-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx ./cli/cli.ts"
  },
  "keywords": [
    "llm",
